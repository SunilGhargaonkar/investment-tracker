# Trading 212 API keys (read-only permissions are enough). Generate one per account.
T212_ISA_KEY=
T212_ISA_SECRET=
T212_INVEST_KEY=
T212_INVEST_SECRET=

# Push notifications via ntfy.sh: create a long random topic and subscribe to it in the ntfy app
NTFY_TOPIC=stock_monitor

# Optional
DROP_ALERT_PCT=10
POLL_SECONDS=60
ALERT_COOLDOWN_HOURS=6
CURRENCY_SYMBOL=£
